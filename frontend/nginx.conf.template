server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Every /api/* request the frontend makes goes to the real backend
    # service, not to this nginx container. ${BACKEND_URL} gets filled
    # in at container START (not build time) by nginx's own envsubst
    # templating - that's why this file lives under
    # /etc/nginx/templates/ instead of /etc/nginx/conf.d/ (see
    # Dockerfile). Set BACKEND_URL as an environment variable on this
    # frontend service pointing at the backend's own https://...onrender.com
    # URL - no rebuild needed if that URL ever changes, just redeploy.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
