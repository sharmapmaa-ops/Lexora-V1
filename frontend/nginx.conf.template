server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Every /api/* request the frontend makes goes to the real backend
    # service, not to this nginx container. ${BACKEND_URL} gets filled
    # in at container START (not build time) by nginx's own envsubst
    # templating - that's why this file lives under
    # /etc/nginx/templates/ instead of /etc/nginx/conf.d/ (see
    # Dockerfile). Set BACKEND_URL as an environment variable on this
    # frontend service pointing at the backend's own https://...onrender.com
    # URL - no rebuild needed if that URL ever changes, just redeploy.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        # Render's edge routes by Host header (as well as TLS SNI) -
        # forwarding the FRONTEND's own hostname here (the old
        # `proxy_set_header Host $host;`) made Render's routing think
        # the request needed to come back to this same service, which
        # is exactly what produced "508 Loop Detected". Set BACKEND_HOST
        # to just the backend's hostname (no https://, no path) as a
        # separate env var, e.g. lexora-v1.onrender.com
        proxy_set_header Host ${BACKEND_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Render (like most modern hosts) puts many services behind
        # shared IPs and routes TLS connections by SNI (the hostname
        # sent during the handshake). nginx does NOT send SNI to HTTPS
        # upstreams by default, which is exactly what caused
        # "SSL_do_handshake() failed ... alert handshake failure" -
        # Render's edge had no way to know which service to route the
        # connection to. This turns SNI on.
        proxy_ssl_server_name on;
        proxy_connect_timeout 90s;
        proxy_send_timeout 90s;
        proxy_read_timeout 90s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
